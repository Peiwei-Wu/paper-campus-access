{
  "manifest_version": 3,
  "name": "论文校园直达",
  "version": "2.0.0",
  "description": "自行配置学校 WebVPN 或 EZproxy 入口，一键通过本校访问论文。",
  "permissions": ["activeTab", "contextMenus", "storage"],
  "background": {"service_worker": "background.mjs", "type": "module"},
  "options_page": "options.html",
  "action": {"default_title": "通过本校打开论文（Ctrl+Shift+Y）"},
  "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}}}
}
